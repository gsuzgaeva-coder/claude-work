# Скопируйте этот файл в .env и впишите свои значения. Файл .env никому не пересылать.

# --- Яндекс Маркет: кабинеты через запятую, для каждого — свой блок ниже ---
YM_CABINETS=VIDINEEVA,POZOYAN

# Ключ: кабинет Маркета → Настройки → API-ключи (права на чтение поставок и каталога)
# business_id и campaign_id видны в адресной строке кабинета
YM_VIDINEEVA_TOKEN=
YM_VIDINEEVA_BUSINESS_ID=
YM_VIDINEEVA_CAMPAIGN_ID=
YM_VIDINEEVA_IP=1 В
YM_VIDINEEVA_IP_NAME=ИП Видинеева А.С. (DOUX SAINT)

YM_POZOYAN_TOKEN=
YM_POZOYAN_BUSINESS_ID=
YM_POZOYAN_CAMPAIGN_ID=
YM_POZOYAN_IP=2 П
YM_POZOYAN_IP_NAME=ИП Позоян А.Р. (ADAM SANTI)

# --- Фулфилменты. Ключи API — из личных кабинетов фулфилментов. ---
# Адрес API и формат ключа агент уточнит по документации при подключении
# и при необходимости добавит сюда недостающие строки.
UPSELLER_API_KEY=
UPMARKET_API_KEY=

# --- Остальные площадки (WB, Ozon, Lamoda) добавляются сюда по мере подключения ---
